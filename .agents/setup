#!/usr/bin/env bash
set -euo pipefail

step() {
    printf '\n==> %s\n' "$1"
}

step "Installing native build dependencies"
packages=(
    build-essential
    ca-certificates
    clang-19
    curl
    libbz2-dev
    libclang-19-dev
    libcurl4-openssl-dev
    liblzma-dev
    libssl-dev
    libzstd-dev
    perl
    pkg-config
    zlib1g-dev
)
missing_packages=()
for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fqx 'install ok installed'; then
        missing_packages+=("$package")
    fi
done
if ((${#missing_packages[@]})); then
    sudo apt-get update -q
    sudo env DEBIAN_FRONTEND=noninteractive \
        apt-get install -y -q "${missing_packages[@]}"
else
    echo "Native build dependencies are already installed."
fi

step "Installing the stable Rust toolchain"
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain stable
fi
# shellcheck disable=SC1091
source "$HOME/.cargo/env"
rustup toolchain install stable --profile minimal --component clippy,rustfmt --no-self-update
rustup default stable

step "Installing Zig 0.15.2 for libghostty-vt"
zig_dir="$HOME/.local/zig-0.15.2"
if [[ ! -x "$zig_dir/zig" ]]; then
    mkdir -p "$zig_dir"
    curl -fsSL https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz \
        | tar -xJ --strip-components=1 -C "$zig_dir"
fi

step "Configuring future orb shells"
profile_marker="# nanalogue Rust and Clang environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<EOF

$profile_marker
source "\$HOME/.cargo/env"
export CLANG_PATH=/usr/bin/clang-19
export LIBCLANG_PATH=/usr/lib/llvm-19/lib
EOF
fi
zig_profile_marker="# nanalogue Zig environment"
if ! grep -Fqx "$zig_profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
    cat >>"$HOME/.bash_profile" <<EOF

$zig_profile_marker
export PATH="$zig_dir:\$PATH"
EOF
fi

step "Fetching Rust dependencies"
CLANG_PATH=/usr/bin/clang-19 \
LIBCLANG_PATH=/usr/lib/llvm-19/lib \
PATH="$zig_dir:$PATH" \
    cargo fetch --locked --quiet

echo "Orb setup complete."
